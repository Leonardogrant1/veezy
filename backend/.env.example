PORT=8080

# Cloudflare R2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-public-domain.com

# Gemini (Google AI Studio — für POC / direkte API)
GEMINI_API_KEY=""

# Google Cloud (Vertex AI — für Produktion)
GCP_LOCATION="europe-west3"
SERVICE_ACCOUNT_B64=""

# OpenAI
OPENAI_API_KEY=""

# RevenueCat
# um den user im server zu authentifizieren und permissions zu checke (security layer)
REVENUECAT_SECRET=""
# Webhook secret — in RevenueCat Dashboard unter Integrations > Webhooks setzen
REVENUECAT_WEBHOOK_SECRET=""